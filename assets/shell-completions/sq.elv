            cand --verbose 'Be more verbose'
            cand -q 'Be more quiet'
            cand --quiet 'Be more quiet'
            cand --batch 'Prevents any kind of prompting'
            cand -h 'Print help (see more with ''--help'')'
            cand --help 'Print help (see more with ''--help'')'
